<?xml version="1.0" encoding="utf-8"?>
<!-- Widget unico "A&C Comandi": modo attivo (tocco = elenco a comparsa), poi 4 colonne su 2 righe:
     Rotazione, Sveglie, VPN (solo Andrea), DNS / Luce, Colori, TV (telecomando), accendi/spegni TV. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/c_radice" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_rifiuti_sfondo" android:padding="6dp">
    <LinearLayout android:id="@+id/c_modo" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.6"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_tasto"
        android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:layout_marginBottom="3dp" android:paddingStart="12dp" android:paddingEnd="12dp">
        <TextView android:id="@+id/c_modo_i" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔔" android:textSize="17sp" android:paddingEnd="8dp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        <TextView android:id="@+id/c_modo_t" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Modo" android:textSize="14sp" android:textStyle="bold" android:ellipsize="end" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        <TextView android:id="@+id/c_modo_s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:visibility="gone" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▾" android:textSize="17sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:paddingTop="3dp" android:paddingBottom="3dp">
        <LinearLayout android:id="@+id/c_rot" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_tasto" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:visibility="visible">
            <TextView android:id="@+id/c_rot_i" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔄" android:textSize="22sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
            <TextView android:id="@+id/c_rot_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rotazione" android:textSize="10sp" android:textStyle="bold" android:ellipsize="end" android:paddingTop="1dp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/c_sveglie" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_tasto" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:visibility="visible">
            <TextView android:id="@+id/c_sveglie_i" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏰" android:textSize="22sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
            <TextView android:id="@+id/c_sveglie_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sveglie" android:textSize="10sp" android:textStyle="bold" android:ellipsize="end" android:paddingTop="1dp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/c_vpn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_tasto" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:visibility="invisible">
            <TextView android:id="@+id/c_vpn_i" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛡️" android:textSize="22sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
            <TextView android:id="@+id/c_vpn_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VPN" android:textSize="10sp" android:textStyle="bold" android:ellipsize="end" android:paddingTop="1dp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/c_dns" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_tasto" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:visibility="visible">
            <TextView android:id="@+id/c_dns_i" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌐" android:textSize="22sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
            <TextView android:id="@+id/c_dns_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DNS" android:textSize="10sp" android:textStyle="bold" android:ellipsize="end" android:paddingTop="1dp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:paddingTop="3dp">
        <LinearLayout android:id="@+id/c_luce" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_tasto" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:visibility="visible">
            <TextView android:id="@+id/c_luce_i" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💡" android:textSize="22sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
            <TextView android:id="@+id/c_luce_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Luce" android:textSize="10sp" android:textStyle="bold" android:ellipsize="end" android:paddingTop="1dp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/c_colori" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_tasto" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:visibility="visible">
            <TextView android:id="@+id/c_colori_i" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎨" android:textSize="22sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
            <TextView android:id="@+id/c_colori_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Colori" android:textSize="10sp" android:textStyle="bold" android:ellipsize="end" android:paddingTop="1dp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/c_tv" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_tasto" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:visibility="visible">
            <TextView android:id="@+id/c_tv_i" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📺" android:textSize="22sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
            <TextView android:id="@+id/c_tv_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TV" android:textSize="10sp" android:textStyle="bold" android:ellipsize="end" android:paddingTop="1dp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/c_tvon" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_tasto" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:visibility="visible">
            <TextView android:id="@+id/c_tvon_i" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🟢" android:textSize="22sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
            <TextView android:id="@+id/c_tvon_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Accendi TV" android:textSize="10sp" android:textStyle="bold" android:ellipsize="end" android:paddingTop="1dp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
