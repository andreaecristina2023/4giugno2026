<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "A&C Luci": fino a 6 luci (3 per riga, tocco = accendi/spegni), sotto una scena e il tasto per aprire A&C. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/l_radice" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_rifiuti_sfondo" android:padding="6dp">
    <TextView android:id="@+id/l_vuoto" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
        android:text="Apri A&amp;C → 💡 Luci per scegliere le luci" android:textSize="13sp" android:visibility="gone" android:textColor="#FFFFFFFF" android:maxLines="2" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:paddingBottom="3dp">
        <LinearLayout android:id="@+id/l_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_tasto" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:visibility="gone">
            <TextView android:id="@+id/l_1_i" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💡" android:textSize="19sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
            <TextView android:id="@+id/l_1_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Luce" android:textSize="10sp" android:textStyle="bold" android:ellipsize="end" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/l_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_tasto" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:visibility="gone">
            <TextView android:id="@+id/l_2_i" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💡" android:textSize="19sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
            <TextView android:id="@+id/l_2_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Luce" android:textSize="10sp" android:textStyle="bold" android:ellipsize="end" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/l_3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_tasto" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:visibility="gone">
            <TextView android:id="@+id/l_3_i" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💡" android:textSize="19sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
            <TextView android:id="@+id/l_3_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Luce" android:textSize="10sp" android:textStyle="bold" android:ellipsize="end" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/l_riga2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:paddingBottom="3dp" android:visibility="gone">
        <LinearLayout android:id="@+id/l_4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_tasto" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:visibility="gone">
            <TextView android:id="@+id/l_4_i" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💡" android:textSize="19sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
            <TextView android:id="@+id/l_4_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Luce" android:textSize="10sp" android:textStyle="bold" android:ellipsize="end" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/l_5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_tasto" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:visibility="gone">
            <TextView android:id="@+id/l_5_i" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💡" android:textSize="19sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
            <TextView android:id="@+id/l_5_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Luce" android:textSize="10sp" android:textStyle="bold" android:ellipsize="end" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/l_6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_tasto" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:visibility="gone">
            <TextView android:id="@+id/l_6_i" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💡" android:textSize="19sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
            <TextView android:id="@+id/l_6_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Luce" android:textSize="10sp" android:textStyle="bold" android:ellipsize="end" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/l_scena" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center"
            android:background="@drawable/widget_tasto" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:visibility="gone">
            <TextView android:id="@+id/l_scena_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶ Scena" android:textSize="12sp" android:textStyle="bold" android:ellipsize="end" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/l_apri" android:layout_width="48dp" android:layout_height="match_parent" android:gravity="center"
            android:background="@drawable/widget_tasto" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙" android:textSize="15sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
