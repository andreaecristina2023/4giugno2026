<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_radice" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_sfondo" android:padding="12dp">
    <TextView android:id="@+id/widget_titolo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="A&amp;C" android:textSize="17sp" android:textStyle="bold" android:textColor="#7A1F3D" android:paddingBottom="4dp"/>
    <TextView android:id="@+id/widget_vuoto" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Niente in programma. Apri l'app per aggiornare." android:textSize="14sp" android:textColor="#59665D" android:visibility="gone"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:id="@+id/riga1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
            <TextView android:id="@+id/barra1" android:layout_width="4dp" android:layout_height="30dp" android:background="#59665D"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp">
                <TextView android:id="@+id/quando1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="#59665D" android:maxLines="1"/>
                <TextView android:id="@+id/testo1" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="#1E2B25" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/riga2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
            <TextView android:id="@+id/barra2" android:layout_width="4dp" android:layout_height="30dp" android:background="#59665D"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp">
                <TextView android:id="@+id/quando2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="#59665D" android:maxLines="1"/>
                <TextView android:id="@+id/testo2" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="#1E2B25" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/riga3" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
            <TextView android:id="@+id/barra3" android:layout_width="4dp" android:layout_height="30dp" android:background="#59665D"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp">
                <TextView android:id="@+id/quando3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="#59665D" android:maxLines="1"/>
                <TextView android:id="@+id/testo3" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="#1E2B25" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/riga4" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
            <TextView android:id="@+id/barra4" android:layout_width="4dp" android:layout_height="30dp" android:background="#59665D"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp">
                <TextView android:id="@+id/quando4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="#59665D" android:maxLines="1"/>
                <TextView android:id="@+id/testo4" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="#1E2B25" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/riga5" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
            <TextView android:id="@+id/barra5" android:layout_width="4dp" android:layout_height="30dp" android:background="#59665D"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp">
                <TextView android:id="@+id/quando5" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="#59665D" android:maxLines="1"/>
                <TextView android:id="@+id/testo5" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="#1E2B25" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
