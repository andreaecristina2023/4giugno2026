<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "A&C Foto": foto a caso dall'album che scorrono da sole -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/f_radice" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_foto_sfondo" android:clipToOutline="true">
    <AdapterViewFlipper android:id="@+id/f_flipper" android:layout_width="match_parent" android:layout_height="match_parent"
        android:autoStart="true" android:flipInterval="7000" android:loopViews="true"
        android:inAnimation="@android:animator/fade_in" android:outAnimation="@android:animator/fade_out"/>
    <TextView android:id="@+id/f_vuoto" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:padding="12dp" android:text="Apri A&amp;C → Album per vedere qui le vostre foto"
        android:textColor="#FFE6EBE3" android:textSize="14sp"/>
</FrameLayout>
