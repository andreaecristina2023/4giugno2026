<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/r_radice" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:background="@android:color/transparent" android:padding="6dp">
    <TextView android:id="@+id/r_quando" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Stasera fuori" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFFFF"
        android:shadowColor="#CC000000" android:shadowRadius="5" android:shadowDx="0" android:shadowDy="1" android:paddingBottom="6dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
        <LinearLayout android:id="@+id/r_box1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal" android:visibility="gone">
            <ImageView android:id="@+id/r_bin1" android:layout_width="44dp" android:layout_height="52dp" android:src="@drawable/bidone" android:scaleType="fitCenter" android:contentDescription="Bidone"/>
            <TextView android:id="@+id/r_nome1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="4dp"
                android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:maxLines="1"
                android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/r_box2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal" android:visibility="gone">
            <ImageView android:id="@+id/r_bin2" android:layout_width="44dp" android:layout_height="52dp" android:src="@drawable/bidone" android:scaleType="fitCenter" android:contentDescription="Bidone"/>
            <TextView android:id="@+id/r_nome2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="4dp"
                android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:maxLines="1"
                android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/r_box3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal" android:visibility="gone">
            <ImageView android:id="@+id/r_bin3" android:layout_width="44dp" android:layout_height="52dp" android:src="@drawable/bidone" android:scaleType="fitCenter" android:contentDescription="Bidone"/>
            <TextView android:id="@+id/r_nome3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="4dp"
                android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:maxLines="1"
                android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/r_nota" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#FFFFFFFF" android:shadowColor="#CC000000" android:shadowRadius="4" android:shadowDx="0" android:shadowDy="1"
        android:paddingTop="4dp" android:maxLines="1" android:visibility="gone"/>
</LinearLayout>
